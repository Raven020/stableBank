{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "risk_scoring.schema.json",
  "title": "risk_scoring rule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rule_id", "rule_type", "version", "domain", "description", "rationale",
    "owner", "last_reviewed", "examples",
    "base_score", "factors", "clamp", "tiers", "lgd_bps"
  ],
  "properties": {
    "rule_id": { "type": "string" },
    "rule_type": { "const": "risk_scoring" },
    "version": { "type": "integer" },
    "domain": { "type": "string" },
    "description": { "type": "string" },
    "rationale": { "type": "string" },
    "owner": { "type": "string" },
    "last_reviewed": { "type": "string" },
    "examples": { "type": "array" },

    "base_score": { "type": "integer" },

    "factors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "input", "bands"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "input": { "type": "string", "minLength": 1 },
          "bands": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["points"],
              "properties": {
                "min": { "type": "number" },
                "max": { "type": "number" },
                "points": { "type": "integer" }
              }
            }
          }
        }
      }
    },

    "clamp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "integer" },
        "max": { "type": "integer" }
      }
    },

    "tiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tier", "min_score", "pd_bps"],
        "properties": {
          "tier": { "type": "string", "minLength": 1 },
          "min_score": { "type": "integer" },
          "pd_bps": { "type": "integer", "minimum": 0 }
        }
      }
    },

    "lgd_bps": { "type": "integer", "minimum": 0 }
  }
}
