{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loan_underwriting.schema.json",
  "title": "loan_underwriting rule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rule_id", "rule_type", "version", "domain", "description", "rationale",
    "owner", "last_reviewed", "examples",
    "eligibility", "pricing_tiers", "allowed_term_months"
  ],
  "properties": {
    "rule_id": { "type": "string" },
    "rule_type": { "const": "loan_underwriting" },
    "version": { "type": "integer" },
    "domain": { "type": "string" },
    "description": { "type": "string" },
    "rationale": { "type": "string" },
    "owner": { "type": "string" },
    "last_reviewed": { "type": "string" },
    "examples": { "type": "array" },

    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_credit_score",
        "min_monthly_income_cents",
        "max_debt_to_income_pct",
        "min_account_age_days",
        "min_risk_score"
      ],
      "properties": {
        "min_credit_score": { "type": "integer", "minimum": 0 },
        "min_monthly_income_cents": { "type": "integer", "minimum": 0 },
        "max_debt_to_income_pct": { "type": "number", "minimum": 0 },
        "min_account_age_days": { "type": "integer", "minimum": 0 },
        "min_risk_score": { "type": "integer", "minimum": 0 }
      }
    },

    "pricing_tiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tier", "min_risk_score", "annual_rate_bps", "max_principal_cents"],
        "properties": {
          "tier": { "type": "string", "minLength": 1 },
          "min_risk_score": { "type": "integer", "minimum": 0 },
          "annual_rate_bps": { "type": "integer", "minimum": 0 },
          "max_principal_cents": { "type": "integer", "minimum": 0 }
        }
      }
    },

    "allowed_term_months": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 1 }
    }
  }
}
