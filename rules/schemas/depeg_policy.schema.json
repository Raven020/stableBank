{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "depeg_policy.schema.json",
  "title": "depeg_policy rule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rule_id", "rule_type", "version", "domain", "description", "rationale",
    "owner", "last_reviewed", "examples",
    "enforced", "reference_currency", "thresholds", "actions_on_depeg", "limitation"
  ],
  "properties": {
    "rule_id": { "type": "string" },
    "rule_type": { "const": "depeg_policy" },
    "version": { "type": "integer" },
    "domain": { "type": "string" },
    "description": { "type": "string" },
    "rationale": { "type": "string" },
    "owner": { "type": "string" },
    "last_reviewed": { "type": "string" },
    "examples": { "type": "array" },

    "enforced": { "type": "boolean" },
    "reference_currency": { "type": "string", "minLength": 1 },

    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["watch_below_usd", "depeg_below_usd"],
      "properties": {
        "watch_below_usd": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "depeg_below_usd": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
      }
    },

    "actions_on_depeg": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },

    "limitation": {
      "type": "string",
      "minLength": 1,
      "description": "PoC-only note: this policy is documented but not actively monitored/enforced."
    }
  }
}
