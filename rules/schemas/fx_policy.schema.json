{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fx_policy.schema.json",
  "title": "fx_policy rule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rule_id", "rule_type", "version", "domain", "description", "rationale",
    "owner", "last_reviewed", "examples",
    "supported_currencies", "pairs", "rounding", "treasury_fx_accounts"
  ],
  "properties": {
    "rule_id": { "type": "string" },
    "rule_type": { "const": "fx_policy" },
    "version": { "type": "integer" },
    "domain": { "type": "string" },
    "description": { "type": "string" },
    "rationale": { "type": "string" },
    "owner": { "type": "string" },
    "last_reviewed": { "type": "string" },
    "examples": { "type": "array" },

    "supported_currencies": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },

    "pairs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["base", "quote", "mock_rate", "source"],
        "properties": {
          "base": { "type": "string", "minLength": 1 },
          "quote": { "type": "string", "minLength": 1 },
          "mock_rate": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
          "source": { "type": "string", "minLength": 1 }
        }
      }
    },

    "rounding": { "type": "string", "enum": ["half_up", "down"] },

    "treasury_fx_accounts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  }
}
